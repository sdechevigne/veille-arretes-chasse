{
  "$schema": "https://opencode.ai/config.json",
  // Instance isolée de la veille : aucun AGENTS.md, aucun outil, aucun MCP. Seuls plugins : authentification Claude
  // (abonnement ; version épinglée, à changer à la main après essai) et manta-accounts (rotation des sièges), copié
  // depuis ~/.config/opencode/plugins à chaque passage.
  "plugin": ["opencode-claude-auth@2.2.0"],
  "share": "disabled",
  "autoupdate": false,
  "mcp": {},
  "agent": {
    "lecteur": {
      "mode": "primary",
      "prompt": "Tu lis des actes administratifs français (arrêtés de chasse) et tu rends uniquement l'objet JSON demandé.",
      "permission": { "*": "deny" }
    }
  }
}
